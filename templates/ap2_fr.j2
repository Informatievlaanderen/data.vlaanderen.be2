         <style>
            .external {
               line-break: anywhere;
            }
            @media screen {
               /* hide from IE3 */
               a[href]:hover {
                  background: #ffa
               }
            }
            p {
               text-align: justify;
            }
            tr:nth-child(even) td {
               background-color: #eee;
            }
            dt,
            dd {
               margin-top: 0;
               margin-bottom: 0
            } /* opera 3.50 */
            dt {
               font-weight: bold
            }
            pre,
            code {
